assets/vc_redist*.exe

# smoke-test leftovers (normally cleaned up automatically)
scripts/smoke-*.tmp
scripts/smoke-clip.mp4

# distribution archives built locally
*.zip

# logs and OS noise
*.log
.DS_Store
Thumbs.db
